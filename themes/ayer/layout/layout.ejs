<%- partial('_partial/head') %>

<body class="<%- (function(){
  var p = page.path || '';
  if (p.indexOf('lyrics') === 0) return 'is-lyrics page-locked';
  if (p.indexOf('project') === 0) return 'page-theme-journey';
  if (p.indexOf('works') === 0) return 'page-theme-works';
  if (p.indexOf('games') === 0) return 'page-theme-games';
  if (p.indexOf('brainwave') === 0) return 'page-theme-brainwave';
  return '';
})() %>">
  <div id="app">
    <main class="content">
      <%- body %>
      <%- partial('_partial/footer', null, {cache: !config.relative_link}) %>
    </main>
    <aside class="sidebar">
      <%- partial('_partial/sidebar') %>
    </aside>
    <%- partial('_partial/modal') %>
    <%- partial('_partial/after-footer') %>

    <% if (theme.music&&theme.music.enable){ %>
    <%- partial('_partial/music') %>
    <% } %>
    <!-- 黑白小牛：兼作返回顶部按钮（音乐盒页不显示） -->
    <% if (!(page.path && page.path.indexOf('lyrics') === 0)) { %>
    <div class="site-mascot" title="回到顶部">
      <img src="/images/cow.svg" alt="回到顶部" />
    </div>
    <% } %>
    <script>
    // 小牛：滚动超过封面高度后淡入（替代原返回顶部箭头），点击平滑回顶
    // 注意：本主题 body 固定视口高度，滚动发生在 main.content 容器内
    (function () {
      var mascot = document.querySelector('.site-mascot');
      if (!mascot) return;
      var scroller = document.querySelector('main.content') || window;
      function getThreshold() {
        var cover = document.querySelector('.cover');
        return cover ? cover.offsetHeight : 400;
      }
      function getScrollY() {
        return scroller === window
          ? (window.pageYOffset || document.documentElement.scrollTop)
          : scroller.scrollTop;
      }
      function onScroll() {
        mascot.classList.toggle('is-visible', getScrollY() > getThreshold());
      }
      mascot.addEventListener('click', function () {
        if (scroller === window) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          scroller.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
      scroller.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      onScroll();
    })();
    </script>
  </div>
</body>

</html>