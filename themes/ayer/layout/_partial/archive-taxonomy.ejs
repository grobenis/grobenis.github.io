<% if (site.categories.length || site.tags.length){ %>
<div class="archive-taxonomy">
  <div class="archive-taxonomy-tabs" role="tablist">
    <% if (site.categories.length){ %>
    <button type="button" class="archive-taxonomy-tab active" data-panel="archive-panel-categories" role="tab" aria-selected="true">
      <i class="ri-folder-2-line"></i><%= __('categories') %>
      <span class="archive-taxonomy-count"><%= site.categories.length %></span>
    </button>
    <% } %>
    <% if (site.tags.length){ %>
    <button type="button" class="archive-taxonomy-tab" data-panel="archive-panel-tags" role="tab" aria-selected="false">
      <i class="ri-price-tag-3-line"></i><%= __('tags') %>
      <span class="archive-taxonomy-count"><%= site.tags.length %></span>
    </button>
    <% } %>
  </div>

  <% if (site.categories.length){ %>
  <div class="archive-taxonomy-panel active" id="archive-panel-categories" role="tabpanel">
    <ul class="category-list">
      <% site.categories.sort('name').each(function(item){ %>
        <% if(item.posts.length){ %>
          <a class="category-list-link" href="<%- config.root %><%- item.path %>" title="<%= item.name %>">
            <li class="category-list-item">
            <%= item.name %><i><%= item.posts.length %></i>
            </li>
          </a>
        <% } %>
      <% }); %>
    </ul>
  </div>
  <% } %>

  <% if (site.tags.length){ %>
  <div class="archive-taxonomy-panel" id="archive-panel-tags" role="tabpanel">
    <div class="archive-tagcloud" id="archiveTagCloud">
      <ul class="category-list">
        <% site.tags.sort('name').each(function(item){ %>
          <% if(item.posts.length){ %>
            <a class="category-list-link" href="<%- config.root %><%- item.path %>" title="<%= item.name %>">
              <li class="category-list-item">
              <%= item.name %><i><%= item.posts.length %></i>
              </li>
            </a>
          <% } %>
        <% }); %>
      </ul>
    </div>
    <button type="button" class="archive-tagcloud-toggle" id="archiveTagCloudToggle" hidden>展开全部标签</button>
  </div>
  <% } %>
</div>
<script>
(function () {
  var box = document.querySelector('.archive-taxonomy');
  if (!box) return;
  var tabs = box.querySelectorAll('.archive-taxonomy-tab');
  var cloud = document.getElementById('archiveTagCloud');
  var toggle = document.getElementById('archiveTagCloudToggle');

  function refreshToggle() {
    if (!cloud || !toggle) return;
    var panel = cloud.closest('.archive-taxonomy-panel');
    if (!panel || !panel.classList.contains('active')) return;
    toggle.hidden = cloud.classList.contains('expanded') ||
      cloud.scrollHeight <= cloud.clientHeight + 4;
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) {
        t.classList.toggle('active', t === tab);
        t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
      });
      box.querySelectorAll('.archive-taxonomy-panel').forEach(function (p) {
        p.classList.toggle('active', p.id === tab.getAttribute('data-panel'));
      });
      refreshToggle();
    });
  });

  if (toggle && cloud) {
    toggle.addEventListener('click', function () {
      var expanded = cloud.classList.toggle('expanded');
      toggle.textContent = expanded ? '收起标签' : '展开全部标签';
    });
  }
})();
</script>
<% } %>
