<!DOCTYPE html>
<html lang="zh-CN">

<head>
  <script>
  /* 暗色模式：在渲染前设置 data-theme，避免首屏闪烁 */
  (function(){try{var t=localStorage.getItem('theme');if(!t){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
  </script>
  <meta charset="utf-8" />
  <% var title = page.title; if (is_archive()) { title = __('archive_a'); if
    (is_month()) { title += ': ' + page.year + '/' + page.month; } else if
    (is_year()) { title += ': ' + page.year; } } else if (is_category()) { title
    = page.category; } else if (is_tag()) {
    title = __('tag') + ': ' + page.tag; } %> <% if (page.keywords){ %>
  <meta name="keywords" content="<%= page.keywords %>,<%= config.keywords %>" />
  <% } else if (config.keywords){ %>
  <meta name="keywords" content="<%= config.keywords %>" />
  <% } %> <% if (page.description){ %>
  <meta name="description" content="<%= page.description %>" />
  <% } else if (config.description){ %>
  <meta name="description" content="<%= config.description %>" />
  <% } %>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <% var ogTitle = page.title ? page.title + ' | ' + config.title : config.title; %>
  <% var ogDesc = page.description || config.description || ''; %>
  <% var ogUrl = (config.url.replace(/\/+$/, '')) + '/' + (page.path || '').replace(/index\.html$/, ''); %>
  <% var ogImage = page.cover || (theme.cover && theme.cover.path) || ''; %>
  <meta property="og:site_name" content="<%= config.title %>" />
  <meta property="og:title" content="<%= ogTitle %>" />
  <meta property="og:description" content="<%= ogDesc %>" />
  <meta property="og:url" content="<%= ogUrl %>" />
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>" />
  <% if (ogImage){ %>
  <meta property="og:image" content="<%- config.url %><%- ogImage %>" />
  <% } %>
  <meta name="twitter:card" content="summary" />
  <link rel="canonical" href="<%= ogUrl %>" />
  <% if (theme.rss){ %>
  <link rel="alternate" type="application/atom+xml" href="<%- url_for(theme.rss) %>" title="<%= config.title %> RSS" />
  <% } %>
  <% if (is_post()) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "<%- page.title.replace(/\\/g, '\\\\').replace(/"/g, '\\"') %>",
    "description": "<%- ogDesc.replace(/\\/g, '\\\\').replace(/"/g, '\\"') %>",
    "url": "<%- ogUrl %>",
    "datePublished": "<%- page.date.toISOString() %>",
    "dateModified": "<%- (page.updated || page.date).toISOString() %>",
    "author": { "@type": "Person", "name": "<%- config.author %>" },
    "publisher": { "@type": "Person", "name": "<%- config.author %>" },
    "mainEntityOfPage": { "@type": "WebPage", "@id": "<%- ogUrl %>" }
  }
  </script>
  <% } %>
  <title>
    <% if (title){ %><%= title %> | <% } %> <%= config.title %>
  </title>
  <% if (theme.favicon){ %>
  <link rel="shortcut icon" href="<%- theme.favicon %>" />
  <% } %>
  <link rel="manifest" href="<%- config.root %>manifest.webmanifest" />
  <meta name="theme-color" content="#403e3e" />
  <link rel="apple-touch-icon" href="<%- config.root %>images/icon-192.png" />
  <% if (theme.cover && theme.cover.enable && is_home()){ %>
  <link rel="preload" as="image" href="<%- theme.cover.path %>" />
  <% } %>
  <%- css('css/main') %>
  <link rel="stylesheet" href="<%- config.root %>css/custom.css?v=<%- Date.now() %>" />
  <% if (theme.progressBar){ %>
  <script src="https://cdn.jsdelivr.net/npm/pace-js@1.0.2/pace.min.js"></script>
  <% } %>
  <%- partial('google-analytics') %>
  <%- partial('baidu-analytics') %>
</head>

</html>
