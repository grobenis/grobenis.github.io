<%# 51.la 第三方统计已停用（改用 Umami 自建统计） %>
<%# <script type="text/javascript" src="https://js.users.51.la/20544303.js"></script> %>

<script>
// 代码块一键复制：为每个 figure.highlight 添加复制按钮
(function () {
  var figures = document.querySelectorAll('figure.highlight');
  Array.prototype.forEach.call(figures, function (fig) {
    if (fig.querySelector('.code-copy-btn')) return;
    var code = fig.querySelector('td.code') || fig.querySelector('pre code') || fig.querySelector('pre');
    if (!code) return;
    fig.style.position = 'relative';
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy-btn';
    btn.title = '复制代码';
    btn.setAttribute('aria-label', '复制代码');
    btn.innerHTML = '<i class="ri-file-copy-line"></i>';
    function showDone() {
      btn.classList.add('copied');
      btn.textContent = '已复制';
      setTimeout(function () {
        btn.classList.remove('copied');
        btn.innerHTML = '<i class="ri-file-copy-line"></i>';
      }, 1500);
    }
    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = code.innerText || code.textContent;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); showDone(); } catch (e) {}
      document.body.removeChild(ta);
    }
    btn.addEventListener('click', function () {
      var text = code.innerText || code.textContent;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(showDone, fallback);
      } else {
        fallback();
      }
    });
    fig.appendChild(btn);
  });
})();
</script>

<script>
// 搜索快捷键：Ctrl/⌘+K 或 / 打开站内搜索并聚焦；Esc 收起。
// 侧边栏的 .nav-item-search 已由 ayer.js 绑定打开逻辑，这里复用它的点击，
// 避免两处各写一套开合状态（含动画中防抖）。
(function () {
  var wrap = document.querySelector('.search-form-wrap');
  var input = document.getElementById('local-search-input');
  var trigger = document.querySelector('.nav-item-search');
  if (!wrap || !input || !trigger) return;

  function isTyping(el) {
    if (!el || !el.tagName) return false;
    var t = el.tagName;
    return t === 'INPUT' || t === 'TEXTAREA' || t === 'SELECT' || el.isContentEditable === true;
  }

  function openSearch() {
    trigger.click();
    // ayer.js 会在 200ms 动画结束后聚焦，这里稍晚一点兜底（面板已开时它也会聚焦）
    setTimeout(function () { input.focus(); }, 240);
  }

  document.addEventListener('keydown', function (e) {
    if (e.defaultPrevented) return;
    if ((e.ctrlKey || e.metaKey) && !e.altKey && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      openSearch();
      return;
    }
    // "/" 只在非输入态触发，避免打断正常打字
    if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey && !isTyping(e.target)) {
      e.preventDefault();
      openSearch();
      return;
    }
    // Esc 只负责收起搜索面板，不干扰页面自身的 Esc 行为（如脑洞页弹窗）
    if (e.key === 'Escape' && wrap.classList.contains('on')) {
      wrap.classList.remove('on');
      input.blur();
    }
  });
})();
</script>

<script>
// 注册 Service Worker（PWA 离线缓存）
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('<%- config.root %>sw.js').catch(function () {});
  });
}
</script>