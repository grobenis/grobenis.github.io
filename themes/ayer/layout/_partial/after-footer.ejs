<%# <script type="text/javascript" src="https://js.users.51.la/20544303.js"></script> %>

<script>
// 代码块一键复制：为每个 figure.highlight 添加复制按钮
(function () {
  var figures = document.querySelectorAll('figure.highlight');
  Array.prototype.forEach.call(figures, function (fig) {
    if (fig.querySelector('.code-copy-btn')) return;
    var code = fig.querySelector('td.code') || fig.querySelector('pre code') || fig.querySelector('pre');
    if (!code) return;
    fig.style.position = 'relative';
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy-btn';
    btn.title = '复制代码';
    btn.setAttribute('aria-label', '复制代码');
    btn.innerHTML = '<i class="ri-file-copy-line"></i>';
    function showDone() {
      btn.classList.add('copied');
      btn.textContent = '已复制';
      setTimeout(function () {
        btn.classList.remove('copied');
        btn.innerHTML = '<i class="ri-file-copy-line"></i>';
      }, 1500);
    }
    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = code.innerText || code.textContent;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); showDone(); } catch (e) {}
      document.body.removeChild(ta);
    }
    btn.addEventListener('click', function () {
      var text = code.innerText || code.textContent;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(showDone, fallback);
      } else {
        fallback();
      }
    });
    fig.appendChild(btn);
  });
})();
</script>