<button class="navbar-toggle"></button>
<nav class="navbar">
  <% if (theme.logo){ %>
  <div class="logo">
    <a href="<%- url_for() %>"><img src="<%- theme.logo %>" alt="<%= config.title %>"></a>
  </div>
  <% } %>
  <%
  /* 侧栏分组：分组与排序的唯一来源是 theme.menuGroups（见 _config.ayer.yml）。
     只渲染显式列出、且 menu 里有链接的键 —— 白名单形式，因此不再依赖
     「第一个中组项叫什么」这种隐式约定，也天然屏蔽上游主题经深合并带回来的旧入口。*/
  function menuGroup(name) {
    var keys = (theme.menuGroups && theme.menuGroups[name]) || [];
    var out = [];
    for (var i = 0; i < keys.length; i++) {
      if (theme.menu && theme.menu[keys[i]] != null) out.push(keys[i]);
    }
    return out;
  }
  %>
  <!-- 上组：技术文章与自我介绍（主页 → 关于） -->
  <ul class="nav nav-main">
    <% menuGroup('main').forEach(function (key) { %>
    <li class="nav-item">
      <a class="nav-item-link" href="<%- url_for(theme.menu[key]) %>"><%= key %></a>
    </li>
    <% }); %>
  </ul>
  <!-- 搜索：位于上组下方 -->
  <% if (theme.search){ %>
  <a class="nav-item-link nav-item-search nav-search-top" title="<%= __('search') %>">
    <i class="ri-search-line"></i>
  </a>
  <% } %>
  <!-- 中组：成果展示 / 自创游戏 / 音乐盒 / 脑洞 -->
  <ul class="nav nav-mid">
    <% menuGroup('mid').forEach(function (key) { %>
    <li class="nav-item">
      <a class="nav-item-link" href="<%- url_for(theme.menu[key]) %>"><%= key %></a>
    </li>
    <% }); %>
  </ul>
  <%
  /* 漏配告警：menu 里有、但没进任何组的项不会被渲染。这条注释只出现在页面源码里，
     `grep "未出现在 theme.menuGroups" public/` 即可查到。*/
  var grouped = menuGroup('main').concat(menuGroup('mid'), menuGroup('life'));
  var orphans = Object.keys(theme.menu || {}).filter(function (k) {
    return grouped.indexOf(k) < 0;
  });
  %>
  <% if (orphans.length) { %>
  <!-- 注意：以下菜单项未出现在 theme.menuGroups，未渲染：<%= orphans.join(' / ') %> -->
  <% } %>
</nav>
<!-- 底部：私人空间（隐藏入口） -->
<nav class="navbar navbar-bottom">
  <ul class="nav nav-life">
    <% menuGroup('life').forEach(function (key) { %>
    <li class="nav-item">
      <a class="nav-item-link" href="<%- url_for(theme.menu[key]) %>"><%= key %></a>
    </li>
    <% }); %>
  </ul>
  <% if (theme.rss){ %>
  <a class="rss-link" href="<%- url_for(theme.rss) %>" target="_blank" rel="noopener" title="RSS 订阅" aria-label="RSS 订阅">
    <i class="ri-rss-line"></i>
  </a>
  <% } %>
  <button class="theme-toggle" id="theme-toggle" title="切换亮/暗模式" aria-label="切换亮/暗模式">
    <i class="ri-moon-line"></i>
  </button>
</nav>
<script>
/* 侧边栏当前页高亮：路径匹配加 is-active；文章页归入「主页」 */
(function () {
  function norm(p) {
    return (p || '/').replace(/\/+$/, '') || '/';
  }
  var here = norm(location.pathname);
  var isPost = /^\/\d{4}\//.test(location.pathname);
  var links = document.querySelectorAll('.nav-item-link[href]');
  Array.prototype.forEach.call(links, function (a) {
    var href = norm(a.getAttribute('href'));
    if (href === here || (isPost && href === '/')) {
      a.classList.add('is-active');
    }
  });
})();
</script>
<script>
/* 暗色模式切换：点亮/暗跟随系统初值，点击切换并持久化 */
(function () {
  var toggle = document.getElementById('theme-toggle');
  if (!toggle) return;
  function current() {
    return document.documentElement.getAttribute('data-theme') || 'light';
  }
  function render() {
    var icon = toggle.querySelector('i');
    if (icon) icon.className = current() === 'dark' ? 'ri-sun-line' : 'ri-moon-line';
  }
  toggle.addEventListener('click', function () {
    var next = current() === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
    render();
  });
  render();
})();
</script>