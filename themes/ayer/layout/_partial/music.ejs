<% if (theme.music && theme.music.enable && theme.music.file) { %>
<audio id="musicPlayer" preload="metadata" src="<%= url_for(theme.music.file) %>"></audio>

<script>
(function () {
    var audio = document.getElementById('musicPlayer');
    var btn = document.getElementById('musicToggle');
    var icon = document.getElementById('musicIcon');
    if (!audio || !btn || !icon) return;
    function setPlaying(on) {
        icon.className = on ? 'ri-pause-line' : 'ri-music-2-line';
        if (on) btn.classList.add('playing'); else btn.classList.remove('playing');
    }
    btn.addEventListener('click', function () {
        if (audio.paused) {
            audio.play();
            setPlaying(true);
        } else {
            audio.pause();
            setPlaying(false);
        }
    });
    audio.addEventListener('ended', function () { setPlaying(false); });
})();
</script>
<% } %>