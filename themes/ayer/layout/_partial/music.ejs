<% if (theme.music && theme.music.enable && theme.music.file) { %>
<div id="music">
    <audio id="musicPlayer" controls preload="metadata" src="<%= url_for(theme.music.file) %>"></audio>
</div>

<style>
    #music {
        position: fixed;
        right: 15px;
        top: 15px;
        z-index: 998;
        background: transparent;
        padding: 0;
    }
    #music audio {
        width: 280px;
        height: 40px;
        outline: none;
        display: block;
        background: transparent;
    }
</style>
<% } %>
