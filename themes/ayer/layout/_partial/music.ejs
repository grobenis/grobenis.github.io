<% if (theme.music && theme.music.enable && theme.music.file) { %>
<div id="music">
    <audio id="musicPlayer" controls preload="metadata" src="<%= url_for(theme.music.file) %>"></audio>
</div>

<style>
    #music {
        position: fixed;
        right: 15px;
        bottom: 20px;
        z-index: 998;
        background: rgba(255, 255, 255, 0.92);
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
        padding: 6px 10px;
    }
    #music audio {
        width: 280px;
        height: 40px;
        outline: none;
        display: block;
    }
</style>
<% } %>
